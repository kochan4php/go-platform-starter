# Copy to infra/.env.production (gitignored) and fill in. deploy.sh generates
# this file with random secrets on first run if it does not exist.
#
# Stack identity — isolates project name, containers and state per env.
STACK_ENV=prod

# Public hostname clients use. Also becomes the nginx server_name.
DOMAIN=example.com

# URL the realtime-info endpoint hands to browsers for websocket connections.
# Use wss:// behind TLS, ws:// otherwise. Path is fixed: /ws
PUBLIC_WS_URL=wss://example.com/ws

# Origins allowed by the gateway CORS layer (same-origin deployment makes
# this nearly moot, but keep it aligned with how users reach the site).
TRUSTED_DOMAINS=https://example.com,http://example.com

# --- secrets (deploy.sh generates these with `openssl rand -hex 32`) -------
POSTGRES_PASSWORD=change-me-generate
ACCESS_TOKEN_SECRET=change-me-generate-min-32-chars-long
INTERNAL_SECRET=change-me-generate
SESSION_CRYPTO_KEYS=change-me-active,change-me-previous
STREAM_SIGNING_KEYS=change-me-active,change-me-previous
# Optional: enables AES-GCM encryption for Redis Stream payloads.
STREAM_ENCRYPTION_KEYS=
REDIS_AUTH_PASSWORD=change-me-generate
REDIS_USERS_PASSWORD=change-me-generate
REDIS_RBAC_PASSWORD=change-me-generate
REDIS_WORKER_PASSWORD=change-me-generate
REDIS_REALTIME_PASSWORD=change-me-generate
REDIS_GATEWAY_PASSWORD=change-me-generate
# Keep this credential offline; application containers never receive it.
REDIS_DLQ_ADMIN_PASSWORD=change-me-generate
# Replication-only credential used by the Redis RDB backup sidecar.
REDIS_BACKUP_PASSWORD=change-me-generate

# --- bootstrap admin (first deploy) ----------------------------------------
ADMIN_EMAIL=admin@example.com
# Random password is generated into this file by deploy.sh; printed once at
# first seed and changeable later through the normal reset flow.
ADMIN_BOOTSTRAP_PASSWORD=change-me-generate

# --- optional ---------------------------------------------------------------
# SENTRY_DSN=
# MAILER_DRIVER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# MAIL_FROM=noreply@example.com
# MAIL_FALLBACK_HOST=smtp-backup.example.com
# MAIL_FALLBACK_PORT=587
# MAIL_FALLBACK_USER=apikey
# MAIL_FALLBACK_PASS=
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# DB_BOOT_RETRY_TIMEOUT=30s
# DB_STATEMENT_TIMEOUT=15s
# DB_IDLE_TX_TIMEOUT=30s
# STREAM_MAXLEN=100000
# WORKER_MIN_IDLE=30s
# DLQ_MAX_DEPTH=10000
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
