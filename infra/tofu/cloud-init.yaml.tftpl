#cloud-config
package_update: true
packages: [python3, python3-apt]
users:
  - default
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for key in admin_ssh_public_keys ~}
      - ${key}
%{ endfor ~}
ssh_pwauth: false
disable_root: true
runcmd:
  - install -d -m 0755 -o ${admin_user} -g ${admin_user} /srv/go-platform
