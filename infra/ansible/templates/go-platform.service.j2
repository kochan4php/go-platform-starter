[Unit]
Description=go-platform Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/go-platform
ExecStart=/usr/bin/docker compose --env-file infra/.env.production -f infra/compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file infra/.env.production -f infra/compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
