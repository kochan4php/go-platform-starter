# TLS termination template (production HTTPS).
#
# Activate:
#   1. Obtain certs (e.g. certbot certonly --standalone -d example.com, or
#      your own CA) and place fullchain + key on the VPS.
#   2. Copy this file to infra/nginx/conf.d/edge-ssl.conf, fix the two paths
#      in ssl_certificate / ssl_certificate_key, set server_name.
#   3. Publish 443 in infra/compose.prod.yml (the commented ports entry).
#   4. Set PUBLIC_WS_URL=wss://example.com/ws in .env.production.
#   5. docker compose --env-file .env.production -f compose.prod.yml up -d edge
#
# The HTTP server in default.conf keeps running for ACME challenges; swap it
# to a permanent redirect once certificates are live.

server {
    listen 8443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.3;
    ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Per-request DNS resolution (see default.conf note)
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Mount host certs by adding to the edge service volumes in compose.prod.yml:
    #   - /etc/letsencrypt:/etc/letsencrypt:ro

    client_max_body_size 1m;
	sendfile on;
	tcp_nopush on;
	open_file_cache max=2000 inactive=60s;
	open_file_cache_valid 120s;

    gzip on;
	gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy credentialless always;
    add_header Cross-Origin-Resource-Policy same-site always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss:; worker-src 'self' blob:" always;

    location = /ws {
        set $up_ws http://gateway:8000;
        proxy_pass $up_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

	location = /docs/openapi.json {
		set $docs_tls_up http://gateway:8000;
		proxy_pass $docs_tls_up;
		proxy_cache openapi;
		proxy_cache_valid 200 5s;
		proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
		add_header X-OpenAPI-Cache $upstream_cache_status always;
	}

    location ~ ^/(api|docs|healthz|readyz|metrics|telemetry|status)(/|$) {
        set $up_gw http://gateway:8000;
        proxy_pass $up_gw;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $correlation_id;
    }

    location /remote/auth/ {
        set $up_auth http://web-auth:8080;
        rewrite ^/remote/auth/(.*)$ /$1 break;
        proxy_pass $up_auth;
        proxy_set_header Host $host;
    }
    location /remote/admin-users/ {
        set $up_users http://web-admin-users:8080;
        rewrite ^/remote/admin-users/(.*)$ /$1 break;
        proxy_pass $up_users;
        proxy_set_header Host $host;
    }
    location /remote/admin-roles/ {
        set $up_roles http://web-admin-roles:8080;
        rewrite ^/remote/admin-roles/(.*)$ /$1 break;
        proxy_pass $up_roles;
        proxy_set_header Host $host;
    }

    location / {
        set $up_shell http://web:8080;
        proxy_pass $up_shell;
        proxy_set_header Host $host;
    }
}
