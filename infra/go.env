# Shared dev defaults for every Go service in infra/compose.base.yml.
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
REDIS_ADDR=redis:6379
ACCESS_TOKEN_SECRET=dev-secret-change-me-16+
INTERNAL_SECRET=dev-internal-secret-change-me
LOG_LEVEL=info
OTEL_TRACE_SAMPLE_RATIO=1
SLOW_QUERY_SAMPLE_RATE=1
ACCESS_LOG_SAMPLE_RATE=0.1
APP_VERSION=dev
GIT_COMMIT=local
BUILD_DATE=local
