{
	"name": "go-platform-starter",
	"image": "mcr.microsoft.com/devcontainers/go:1-1.27-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/node:1": {
			"nodeGypDependencies": true,
			"version": "22"
		}
	},
	"forwardPorts": [5173, 5174, 5175, 5176, 8010, 8025, 5540, 8087],
	"postCreateCommand": "corepack enable && pnpm install --frozen-lockfile && go mod download",
	"remoteUser": "vscode",
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"golang.go",
				"ms-azuretools.vscode-docker",
				"redhat.vscode-yaml"
			]
		}
	}
}
