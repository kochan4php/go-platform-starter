{
	"name": "@starter/contracts",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Generated API types (from the statically composed aggregate spec) + typed fetch wrapper with silent refresh.",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./auth": "./src/auth.ts",
		"./gateway": "./src/gateway.ts",
		"./users": "./src/users.ts",
		"./rbac": "./src/rbac.ts",
		"./realtime": "./src/realtime.ts",
		"./worker": "./src/worker.ts",
		"./platform": "./src/platform.ts",
		"./template": "./src/template.ts",
		"./schemas": "./src/schemas.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"gen": "node ../../scripts/compose-specs.mjs && openapi-typescript gen/openapi.json -o src/gen.d.ts && node ../../scripts/generate-contract-modules.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"openapi-fetch": "^0.15.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"js-yaml": "^4.1.0",
		"openapi-typescript": "^7.8.0",
		"vitest": "^2.1.8"
	}
}
