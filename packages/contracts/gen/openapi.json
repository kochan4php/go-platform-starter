                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/viewer": {
      "get": {
        "operationId": "listAuditEntries",
        "summary": "paginated audit trail, newest first",
        "x-required-permission": "audit:read:any",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
