{
  "openapi": "3.0.3",
  "info": {
    "title": "platform aggregate API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "create credentials; emits user.created onto users.events",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "email": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "email already registered (documented enumeration trade — see PLAN risks)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        },
        "x-rate-limit-class": "strict"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "uniform-401 login with lockout; mints access token + sets refresh cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "logged in",
            "headers": {
              "Set-Cookie": {
                "description": "refresh_token httpOnly cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "accessToken": {
                              "type": "string"
                            },
                            "user": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "format": "int64"
                                },
                                "email": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "unknown/wrong/locked are indistinguishable (incl. timing)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        },
        "x-rate-limit-class": "strict"
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "rotate the refresh cookie (reuse kills the family) and mint a new access token",
        "responses": {
          "200": {
            "description": "rotated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "accessToken": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "missing/invalid/replayed refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        },
        "x-rate-limit-class": "strict"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "revoke the session carried by the refresh cookie and clear it",
        "responses": {
          "200": {
            "description": "logged out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOK"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "operationId": "listSessions",
        "summary": "active sessions of the authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-auth": "required",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Session"
                              }
                            },
                            "meta": {
                              "$ref": "#/components/schemas/EnvelopeMeta"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeAllSessions",
        "summary": "revoke every other session of the authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-auth": "required",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOK"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions/{id}": {
      "delete": {
        "operationId": "revokeSession",
        "summary": "revoke one session of the authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-auth": "required",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOK"
                }
              }
            }
          },
          "404": {
            "description": "unknown session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/forgot": {
      "post": {
        "operationId": "forgotPassword",
        "summary": "always-200 password reset request (anti-enumeration)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "uniform response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOK"
                }
              }
            }
          }
        },
        "x-rate-limit-class": "strict"
      }
    },
    "/api/v1/auth/reset": {
      "post": {
        "operationId": "resetPassword",
        "summary": "consume a single-use reset token, set new password, wipe all sessions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "password updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOK"
                }
              }
            }
          },
          "400": {
            "description": "invalid/expired/consumed token or weak password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        },
        "x-rate-limit-class": "strict"
      }
    },
    "/api/v1/docs": {
      "get": {
        "operationId": "scalarDocs",
        "summary": "Scalar UI over the aggregate spec",
        "responses": {
          "200": {
            "description": "html"
          }
        }
      }
    },
    "/api/v1/docs/openapi.json": {
      "get": {
        "operationId": "aggregateSpec",
        "summary": "aggregate OpenAPI document composed from every upstream at boot",
        "responses": {
          "200": {
            "description": "json",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rbac/permissions": {
      "get": {
        "operationId": "listPermissions",
        "summary": "the compile-time catalog persisted in the db",
        "x-required-permission": "permission:read:any",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rbac/roles": {
      "post": {
        "operationId": "createRole",
        "x-required-permission": "role:create:any",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Role"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "duplicate role name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listRoles",
        "x-required-permission": "role:read:any",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Role"
                              }
                            },
                            "meta": {
                              "$ref": "#/components/schemas/EnvelopeMeta"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rbac/roles/{id}": {
      "patch": {
        "operationId": "updateRole",
        "summary": "rename/describe and/or sync the permission set; bumps affected users' ver",
        "x-required-permission": "role:update:any",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/RoleInput"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "permissions": {
                        "type": "array",
                        "description": "full replacement set; unknown permission -> 400",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Role"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "unknown permission in set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          },
          "404": {
            "description": "unknown role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteRole",
        "x-required-permission": "role:delete:any",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOK"
                }
              }
            }
          },
          "404": {
            "description": "unknown role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rbac/internal/claims/{sub}": {
      "get": {
        "operationId": "resolveClaims",
        "summary": "internal API — perms[] + ver for a subject; requires the shared internal secret",
        "x-internal": true,
        "security": [],
        "parameters": [
          {
            "name": "sub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "perms": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "ver": {
                              "type": "integer",
                              "format": "int64"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "missing/wrong internal secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "operationId": "realtimeInfo",
        "summary": "ws url + protocol version for the web client",
        "x-auth": "required",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "wsUrl": {
                              "type": "string"
                            },
                            "protocol": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "me",
        "summary": "the caller's profile, served purely from identity headers",
        "x-auth": "required",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Profile"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "no identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "operationId": "createUserProfile",
        "summary": "provision a profile row for an existing sub",
        "x-required-permission": "user:create:any",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Profile"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "profile already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeFail"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listUsers",
        "summary": "paginated profiles (?limit&offset)",
        "x-required-permission": "user:read:any",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeOK"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Profile"
                              }
                            },
                            "meta": {
                              "$ref": "#/components/schemas/EnvelopeMeta"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "operationId": "getUser",
        "x-required-permission": "user:read:any",
        "parameters": [
          {
            "name": "id",
