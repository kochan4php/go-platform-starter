# Application PORT
PORT=3000

# Database PostgreSQL URI
DATABASE_URL=postgresql://dev:dev@localhost:5432/expressts

# Pg connection pool size
DB_POOL_MAX=20

# JWT Secret — change these in any real deployment
ACCESS_TOKEN_SECRET=dsklamfklsamfklswamklas
REFRESH_TOKEN_SECRET=ldkcmsamfklasmfklasm
SESSION_TOKEN_SECRET=kasdmalkdmasklmaskl

# Token lifetimes (jsonwebtoken duration format)
ACCESS_TOKEN_TTL=5h
REFRESH_TOKEN_TTL_DAYS=5

# Session cookie hardening (set SECURE=true behind HTTPS)
SESSION_COOKIE_NAME=session-backend
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Rate limiting (global + stricter auth limiter for login/register)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Trusted Domains (comma-separated origins for CORS + Socket.IO)
TRUSTED_DOMAINS=
