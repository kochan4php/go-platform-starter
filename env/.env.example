# Application PORT
PORT=3000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Database PostgreSQL URI
DATABASE_URL=postgresql://dev:dev@localhost:5432/expressts

# Pg connection pool size
DB_POOL_MAX=20

# JWT Secret — min 16 chars, change these in any real deployment
ACCESS_TOKEN_SECRET=dsklamfklsamfklswamklas
REFRESH_TOKEN_SECRET=ldkcmsamfklasmfklasm
SESSION_TOKEN_SECRET=kasdmalkdmasklmaskl

# Token lifetimes (duration format: <number>(s|m|h|d))
ACCESS_TOKEN_TTL=5h
REFRESH_TOKEN_TTL_DAYS=5

# Session cookie hardening (set SECURE=true behind HTTPS)
SESSION_COOKIE_NAME=session-backend
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Rate limiting (global + stricter auth limiter for login/register)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Login lockout after repeated failures
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mailer: console prints emails to stdout, smtp sends via the server below
MAILER_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.local

# Bootstrap admin password — if unset, a random one is generated and printed once at seed time
ADMIN_BOOTSTRAP_PASSWORD=

# Trusted Domains (comma-separated origins for CORS + Socket.IO)
TRUSTED_DOMAINS=
