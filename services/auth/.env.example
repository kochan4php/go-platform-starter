PORT=8080
LOG_LEVEL=info
SLOW_QUERY_THRESHOLD=500ms

DATABASE_URL=postgres://app:app@127.0.0.1:5432/app?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
ACCESS_TOKEN_SECRET=change-me-min-16-chars!!
ACCESS_TTL_MINUTES=30
REFRESH_TTL_DAYS=7
BCRYPT_COST=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RESET_TTL_MINUTES=15
APP_PUBLIC_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
RATE_GLOBAL_PER_MINUTE=120
RATE_STRICT_PER_MINUTE=10
