{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "lib": ["ESNext"],
        "types": ["vitest/globals", "node"]
    },
    "exclude": ["node_modules", "dist", "tests", "create-env.ts", "__tests__", "__mocks__", "*.config.ts", "*.config.mts"]
}
