# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age -- pnpm is the package manager here and pnpm-workspace.yaml sets minimumReleaseAge
# Mirrors the pnpm-workspace minimumReleaseAge guard (7 days, in minutes).
minimum-release-age=10080
prefer-offline=true
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
