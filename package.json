{
    "name": "express-ts-starter",
    "version": "2.0.0",
    "description": "Express.ts Server starter template",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "test": "cross-env NODE_ENV=test vitest run",
        "typecheck": "tsc -p . --noEmit",
        "update-deps": "pnpm update --latest",
        "setup-app": "pnpm install && pnpm create-env",
        "start:local:dev": "cross-env NODE_ENV=local tsx --watch -r dotenv/config src/server.ts",
        "start:dev": "cross-env NODE_ENV=development tsx --watch -r dotenv/config src/server.ts",
        "start:stage": "cross-env NODE_ENV=staging node --max-old-space-size=512 dist/server.js",
        "start:prod": "cross-env NODE_ENV=production node --max-old-space-size=512 dist/server.js",
        "start:prod:local": "cross-env NODE_ENV=production.local node --max-old-space-size=512 dist/server.js",
        "docker:db:dev:up": "pnpm docker:db:dev:down && docker compose -f ./docker/docker-compose.yml up -d",
        "docker:db:dev:down": "docker compose -f ./docker/docker-compose.yml down",
        "docker:image:rm": "docker image rm express_ts_starter postgres",
        "docker:volume:rm": "docker volume rm postgres-data",
        "docker:up": "pnpm docker:down && docker compose up -d",
        "docker:down": "docker compose down",
        "db:init": "cross-env NODE_ENV=local tsx src/database/scripts/db.ts up",
        "db:migrate:undo": "cross-env NODE_ENV=local tsx src/database/scripts/db.ts undo",
        "build": "node -e \"fs.rmSync('./dist',{recursive:true,force:true})\" && tsc -p .",
        "sast": "pnpm dlx semgrep --config auto --error src/",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "create-env": "tsx create-env.ts",
        "prepare": "husky"
    },
    "keywords": [
        "express",
        "typescript",
        "starter",
        "template",
        "starter-template",
        "express.ts",
        "expressjs",
        "express.js",
        "postgresql",
        "sequelize",
        "socket.io"
    ],
    "author": "Deo Subarno",
    "license": "Apache-2.0",
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,json,jsonc}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.1.2",
        "@types/npmlog": "^7.0.0",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.1",
        "cross-env": "^10.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "supertest": "^7.2.2",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@apidevtools/swagger-parser": "^12.1.0",
        "@scalar/express-api-reference": "^0.10.12",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.11.0",
        "npmlog": "^7.0.1",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6",
        "socket.io": "^4.8.3",
        "tsyringe": "^4.10.0",
        "umzug": "^3.8.3",
        "zod": "^4.4.3"
    }
}
