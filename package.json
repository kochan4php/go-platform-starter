{
    "name": "express-ts-starter",
    "version": "1.0.0-lts",
    "description": "Express.ts Server starter template",
    "main": "server.js",
    "scripts": {
        "test": "cross-env NODE_ENV=test vitest run",
        "update-deps": "pnpm update --latest",
        "setup-app": "npm install && npm run create-env",
        "setup-app:pnpm": "pnpm install && pnpm create-env",
        "setup-app:win": "npm install; npm run create-env",
        "setup-app:win:pnpm": "pnpm install && pnpm create-env",
        "start:local:dev": "cross-env NODE_ENV=local tsx --watch -r dotenv/config src/server.ts",
        "start:dev": "cross-env NODE_ENV=development tsx --watch -r dotenv/config src/server.ts",
        "start:stage": "cross-env NODE_ENV=staging node --max-old-space-size=512 dist/server.js",
        "start:prod": "cross-env NODE_ENV=production node --max-old-space-size=512 dist/server.js",
        "start:prod:local": "cross-env NODE_ENV=production.local node --max-old-space-size=512 dist/server.js",
        "docker:db:dev:up": "pnpm docker:db:dev:down && docker compose -f ./docker/docker-compose.yml up -d",
        "docker:db:dev:down": "docker compose -f ./docker/docker-compose.yml down",
        "docker:image:rm": "docker image rm express_ts_starter postgres",
        "docker:volume:rm": "docker volume rm postgres-data",
        "docker:up": "pnpm docker:down && docker compose up -d",
        "docker:down": "docker compose down",
        "build": "rm -rf ./dist && tsc -p .",
        "sast": "pnpm dlx semgrep --config auto --error src/",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "prettier:check": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "create-env": "ts-node create-env.ts"
    },
    "keywords": [
        "express",
        "typescript",
        "starter",
        "template",
        "starter-template",
        "express.ts",
        "expressjs",
        "express.js",
        "postgresql",
        "prisma",
        "socket.io"
    ],
    "author": "Deo Subarno",
    "license": "Apache-2.0",
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cli-color": "^2.0.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.1.2",
        "@types/npmlog": "^7.0.0",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "cli-color": "^2.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-security": "^4.0.1",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@apidevtools/swagger-parser": "^12.1.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@scalar/express-api-reference": "^0.10.12",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.11.0",
        "npmlog": "^7.0.1",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.3",
        "tsyringe": "^4.10.0",
        "zod": "^4.4.3"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,css,md,html}": [
            "pnpm prettier:fix"
        ],
        "**/*.{js,jsx,ts,tsx}": [
            "pnpm lint:fix",
            "pnpm prettier:fix"
        ]
    },
    "prisma": {}
}
